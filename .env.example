# .env.example — copie para .env e preencha com seus valores reais
# NUNCA suba o .env para o GitHub (adicione ao .gitignore)

# ─── Google Analytics ────────────────────────────────────────────────────────
# Caminho para o arquivo JSON da Service Account do Google Cloud
# Instruções: veja o README.md para como criar essa conta de serviço
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Sites monitorados pelo agente
# propertyId: use o formato "properties/XXXXXXXXX"
GA_SITES=[{"name":"Meu Site Principal","propertyId":"properties/123456789"}]

# ─── Groq ────────────────────────────────────────────────────────────────────
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ─── Telegram Bot ────────────────────────────────────────────────────────────
# Token do bot criado via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=123456789:AAF...

# ID do chat que vai receber as mensagens
# Para descobrir: envie uma mensagem pro bot e acesse:
# https://api.telegram.org/bot<SEU_TOKEN>/getUpdates
# O campo "chat.id" é o valor que você precisa
TELEGRAM_CHAT_ID=987654321
